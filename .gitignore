# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/

# Secrets - NEVER commit
.secrets/
*.token
*.pat

# OS
.DS_Store
Thumbs.db

# Phase-2 (now legacy/): raw videos are large; CSVs/JSONs stay committed for provenance
phase2/data/**/*.mp4
phase2/data/**/*.avi
phase2/results/**/_windows_cache.json
legacy/phase2/data/**/*.mp4
legacy/phase2/data/**/*.avi

# Note: runs/ IS committed deliberately (immutable experiment records).
# Phase-1 original results in runs/ are part of the frozen baseline.

# Brain track (D1+): third-party model is re-cloned at the pinned commit by
# brain/setup/setup_model.py; the venv is local; bulky spike parquets stay
# out (canonical JSON evidence + verdicts ARE committed).
brain/.venv/
brain/third_party/
brain/results/**/*.parquet
brain/results/*.log
brain/results/**/*.log

# D7 perf study: regenerable heavy artifacts (cpp_project 589 MB, filtered
# connectome parquets ~61 MB) stay out of git; records/tables/spike files committed
brain/results/perf_study/cpp_project/
brain/results/perf_study/*_connectivity.parquet
brain/results/perf_study/*_completeness.csv
